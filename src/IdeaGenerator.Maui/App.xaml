<?xml version="1.0" encoding="UTF-8"?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IdeaGenerator.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#4F46E5</Color>
            <Color x:Key="PrimaryDark">#3730A3</Color>
            <Color x:Key="PrimarySoft">#EEF2FF</Color>
            <Color x:Key="Accent">#F59E0B</Color>
            <Color x:Key="AppBackground">#F8FAFC</Color>
            <Color x:Key="Surface">#FFFFFF</Color>
            <Color x:Key="TextPrimary">#0F172A</Color>
            <Color x:Key="TextSecondary">#475569</Color>
            <Color x:Key="TextMuted">#64748B</Color>
            <Color x:Key="Border">#E2E8F0</Color>
            <Color x:Key="Success">#15803D</Color>
            <Color x:Key="Warning">#B45309</Color>
            <Color x:Key="Error">#B91C1C</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
