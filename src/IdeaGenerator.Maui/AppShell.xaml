<?xml version="1.0" encoding="UTF-8"?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:IdeaGenerator.Maui.Views"
       x:Class="IdeaGenerator.Maui.AppShell"
       FlyoutBehavior="Flyout">

    <FlyoutItem Title="Idea Library"
                Route="IdeaLibrary"
                Shell.NavBarIsVisible="False"
                Shell.TabBarIsVisible="False">
        <ShellContent Title="Idea Library"
                      ContentTemplate="{DataTemplate views:IdeaLibraryPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Discover Ideas"
                Route="DiscoverIdeas"
                Shell.NavBarIsVisible="False"
                Shell.TabBarIsVisible="False">
        <ShellContent Title="Discover Ideas"
                      ContentTemplate="{DataTemplate views:DiscoverIdeasPage}" />
    </FlyoutItem>
</Shell>
