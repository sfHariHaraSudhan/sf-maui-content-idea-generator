<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows is built on Windows; Mac Catalyst is built on macOS. -->
    <TargetFrameworks>net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>

    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <OutputType>Exe</OutputType>

    <!-- Application identity and version metadata -->
    <ApplicationTitle>Syncfusion Content Idea Generator</ApplicationTitle>
    <ApplicationId>com.syncfusion.ideagenerator</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>Syncfusion MAUI Content Team</Authors>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Local Mac is Apple Silicon. -->
    <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('osx'))">maccatalyst-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IdeaGenerator.Core\IdeaGenerator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
  </ItemGroup>

</Project>
