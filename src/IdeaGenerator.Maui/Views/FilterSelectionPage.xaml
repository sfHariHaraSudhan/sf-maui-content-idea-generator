<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IdeaGenerator.Maui.Views.FilterSelectionPage"
             Title="Filter"
             BackgroundColor="#661F2937">

    <Grid>
        <Border BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource Border}" StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                HorizontalOptions="Center" VerticalOptions="Center"
                MaximumWidthRequest="420" MaximumHeightRequest="560"
                Padding="16,14">
            <Grid RowDefinitions="Auto,*,Auto">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <Label Grid.Column="0" x:Name="TitleLabel"
                           Text="Filter"
                           FontSize="17" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                    <Button Grid.Column="1" Text="Cancel"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource TextSecondary}"
                            Stroke="{StaticResource Border}" StrokeThickness="1"
                            CornerRadius="10" Padding="12,6"
                            MinimumHeightRequest="34"
                            Clicked="OnCancelClicked" />
                </Grid>

                <ScrollView Grid.Row="1">
                    <VerticalStackLayout x:Name="OptionsList" Spacing="2" Padding="2" />
                </ScrollView>

                <Label Grid.Row="2"
                       Text="Choose an option to apply it, or Cancel to keep the current value."
                       FontSize="11" TextColor="{StaticResource TextMuted}"
                       Margin="0,10,0,0" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
